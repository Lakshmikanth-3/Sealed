# mock | testnet | mainnet
NEAR_NETWORK=mock
# Relayer account that pays for anchors (testnet: create at https://testnet.mynearwallet.com or `near account create-account`)
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=ed25519:...
# Optional: account with contract/anchor.js deployed. Defaults to NEAR_ACCOUNT_ID (no contract: tx still records args).
ANCHOR_CONTRACT=
NEAR_RPC_URL=
PORT=8787
# Not used yet; NEAR AI Cloud attestation is stubbed.
NEARAI_API_KEY=
