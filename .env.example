# Sealed configuration. Copy to .env; never commit .env.
NEAR_NETWORK=testnet
# Required. Comma-separated HTTPS RPC endpoints, used in order (also used by browsers).
NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
# Required. Block explorer used for transaction and account links.
NEAR_EXPLORER_URL=https://testnet.nearblocks.io

# Deployed contract and the release-service operator (written by `npm run contract:deploy`).
SEAL_CONTRACT=sealed.kanth_s.testnet
SEAL_OPS_ACCOUNT=sealops.kanth_s.testnet
SEAL_OPS_PRIVATE_KEY=
# Only needed for `npm run contract:upgrade`.
SEAL_CONTRACT_PRIVATE_KEY=
# Parent account that creates the two accounts above (signs via near CLI keychain).
CONTRACT_OWNER=kanth_s.testnet

# Testnet NEAR sent to each app-created holder account so it can pay for its release.
SEAL_HOLDER_FUNDING_NEAR=0.05

# Encrypts escrowed keys at rest (single-mode file key, split-mode part wrap key).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEAL_ESCROW_SECRET=

# Optional: require a token to create seals (each seal spends testnet NEAR from the operator).
SEAL_CREATE_TOKEN=
SEAL_CREATE_PER_HOUR=20

PORT=8787
DATA_DIR=
# Set when behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=
PUBLIC_ORIGIN=

# Approximate location for alerts: an HTTPS lookup URL containing {ip}. Empty = no IP location.
GEOIP_URL=

# Alert email via Resend. Without these, no email is sent (alerts still appear in the owner's feed).
RESEND_API_KEY=
ALERT_EMAIL_FROM=
# WhatsApp / SMS via Twilio. Without these, no messages are sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
