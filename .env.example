# testnet | mainnet
# Workers approve direct v2 transactions in their own wallet.
NEAR_NETWORK=testnet
# Expected relayer account (public identity, also used for read-only verification).
NEAR_ACCOUNT_ID=
# Dedicated sponsor signing key, ed25519 format. Leave blank for read-only verification.
NEAR_PRIVATE_KEY=
# Required for testnet/mainnet: account with the anchor contract deployed. Failed calls are rejected.
ANCHOR_CONTRACT=
NEAR_RPC_URL=
PORT=8787
# Optional verified private AI: requires Node 24.22.1+ and a supported TEE model.
NEARAI_API_KEY=

# Worker-signed testnet relay. Disabled until the owner chooses actual limits.
RELAY_ENABLED=false
# An absolute directory on persistent disk; never an ephemeral hosting filesystem.
DATA_DIR=
# Owner acknowledgement of the hosting disk configuration. The app cannot
# independently prove that a provider will retain this disk after redeployment.
RELAY_PERSISTENT_DISK=false
# Required positive integer job limits; failed/uncertain jobs retain reservations.
RELAY_WORKER_DAILY_LIMIT=
RELAY_GLOBAL_DAILY_LIMIT=
# Shared HTTP request limit per minute (includes status polling).
RELAY_REQUESTS_PER_MINUTE=
# Owner-chosen liquid balance floor in yoctoNEAR (integer), not a fee ceiling.
RELAY_MIN_BALANCE_YOCTO=

NEARAI_MODEL=
# Owner-created service token; give only to approved AI users. Never expose via /api/config.
AI_ACCESS_TOKEN=
# Exact HTTPS origin when deployed (no trailing slash).
PUBLIC_ORIGIN=

# Operator-created publishing token, shared only with invited users.
PUBLISH_ACCESS_TOKEN=
# Read-only live integration verification (actual transaction only).
WORKER_ACCOUNT_ID=
LIVE_TX_HASH=

# Dedicated contract deployment account; blank until chosen by the operator.
CONTRACT_OWNER=
CONTRACT_PRIVATE_KEY=
CONTRACT_MAX_WORKERS=
CONTRACT_MAX_DAYS_PER_WORKER=

# SHA-256 of approved appCompose bytes, obtained from independently reviewed NEAR AI deployment evidence.
NEARAI_GATEWAY_COMPOSE_SHA256=
NEARAI_MODEL_COMPOSE_SHA256=

CONTRACT_OWNER_PRIVATE_KEY=

# Optional explicit quote-collateral endpoint. Empty uses the SDK default; no automatic failover.
NEARAI_PCCS_URL=
