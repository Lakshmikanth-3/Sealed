# mock | testnet | mainnet
# Live unsigned HTTP/demo anchoring is disabled until worker-signed v2 integration is complete.
NEAR_NETWORK=mock
# Expected relayer account (public identity, also used for read-only verification).
NEAR_ACCOUNT_ID=
# Dedicated sponsor signing key, ed25519 format. Leave blank for read-only verification.
NEAR_PRIVATE_KEY=
# Required for testnet/mainnet: account with the anchor contract deployed. Failed calls are rejected.
ANCHOR_CONTRACT=
NEAR_RPC_URL=
PORT=8787
# Not used yet; NEAR AI Cloud attestation is stubbed.
NEARAI_API_KEY=

# Worker-signed testnet relay. Disabled until the owner chooses actual limits.
RELAY_ENABLED=false
# An absolute directory on persistent disk; never an ephemeral hosting filesystem.
DATA_DIR=
# Owner acknowledgement of the hosting disk configuration. The app cannot
# independently prove that a provider will retain this disk after redeployment.
RELAY_PERSISTENT_DISK=false
# Required positive integer job limits; failed/uncertain jobs retain reservations.
RELAY_WORKER_DAILY_LIMIT=
RELAY_GLOBAL_DAILY_LIMIT=
# Shared HTTP request limit per minute (includes status polling).
RELAY_REQUESTS_PER_MINUTE=
# Owner-chosen liquid balance floor in yoctoNEAR (integer), not a fee ceiling.
RELAY_MIN_BALANCE_YOCTO=
