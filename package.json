{
  "name": "sealed-paper",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Files nobody can open before a chosen second: K-of-N key holders, contract-enforced unlock time and a public access log on NEAR testnet.",
  "scripts": {
    "build": "node scripts/build-client.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "prestart": "npm run build",
    "dev:all": "npm run build && node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-tests.js",
    "test:e2e": "npm run build && node scripts/browser-tests.js --config playwright.live.config.js",
    "test:chain": "node --env-file-if-exists=.env scripts/chain-smoke.js",
    "contract:test": "node scripts/contract.js test",
    "contract:build": "node scripts/contract.js build",
    "contract:deploy": "node --env-file-if-exists=.env scripts/deploy-sealed.js",
    "contract:upgrade": "node --env-file-if-exists=.env scripts/upgrade-sealed.js",
    "test:access": "node --env-file-if-exists=.env scripts/access-smoke.js"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "buffer": "6.0.3",
    "near-api-js": "7.2.0",
    "process": "0.11.10",
    "qrcode-generator": "1.4.4",
    "shamir-secret-sharing": "0.0.4",
    "util": "0.12.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "nanoid": "5.1.16",
    "decode-uri-component": "0.5.1"
  }
}
