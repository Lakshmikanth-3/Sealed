{
  "name": "appeal-record",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Worker-owned, tamper-evident work record with NEAR anchors and a one-click verifier.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:browser:portable": "node scripts/browser-tests.js",
    "verify": "node scripts/verify-pack.js",
    "relay:admin": "node --env-file-if-exists=.env scripts/relay-admin.js",
    "economics": "node scripts/economics.js",
    "contract:lock": "node scripts/contract.js lock",
    "contract:build": "node scripts/contract.js build",
    "contract:test": "node scripts/contract.js test",
    "build": "node scripts/build-client.js",
    "prestart": "npm run build",
    "test:live": "node --env-file-if-exists=.env scripts/check-live.js",
    "contract:deploy": "node --env-file-if-exists=.env scripts/deploy-contract.js",
    "shares:backup": "node --env-file-if-exists=.env scripts/backup-shares.js",
    "contract:register": "node --env-file-if-exists=.env scripts/register-worker.js",
    "ai:inspect": "node --env-file-if-exists=.env scripts/inspect-ai.js"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@nearai/inference-sdk": "0.3.0",
    "buffer": "6.0.3",
    "near-api-js": "7.2.0",
    "process": "0.11.10",
    "util": "0.12.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "nanoid": "5.1.16",
    "decode-uri-component": "0.5.1"
  }
}
