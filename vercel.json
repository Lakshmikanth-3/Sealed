{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && node scripts/vercel-output.js",
  "outputDirectory": ".vercel-static",
  "functions": {
    "api/index.js": { "includeFiles": "{public,lib}/**", "maxDuration": 60, "memory": 1024 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
